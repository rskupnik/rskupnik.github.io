      "versionNonce": 1866011588,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778862469547,
      "link": null,
      "locked": false,
      "text": "We measure it separately for horizontal velocity\nand for vertical velocity.\nFor horizontal we simply need to check how big the\nvelocity is in the left and right cells.\nFor vertical - in top and bottom cells.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We measure it separately for horizontal velocity\nand for vertical velocity.\nFor horizontal we simply need to check how big the\nvelocity is in the left and right cells.\nFor vertical - in top and bottom cells.",
      "autoResize": true,
      "lineHeight": 1.25
    },
