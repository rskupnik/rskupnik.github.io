      "seed": 2055028734,
      "version": 692,
      "versionNonce": 1320760572,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1778860100810,
      "link": null,
      "locked": false,
      "text": "We start with a guess. Then we iterate a few times (20 should be enough).\nIn each loop - we calculate the values as above.\nEach loop works on updated values -\n- thus getting more and more near the \"correct\" answer.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We start with a guess. Then we iterate a few times (20 should be enough).\nIn each loop - we calculate the values as above.\nEach loop works on updated values -\n- thus getting more and more near the \"correct\" answer.",
      "autoResize": true,
      "lineHeight": 1.25
    },
