      "index": "bEQ",
      "roundness": null,
      "seed": 595408561,
      "version": 259,
      "versionNonce": 1749679551,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778931838849,
      "link": null,
      "locked": false,
      "text": "With pressure gradient in hand,\nusing it to correct the divergence\nis simple - subtract one from the other",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "With pressure gradient in hand,\nusing it to correct the divergence\nis simple - subtract one from the other",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
