      "link": null,
      "locked": false,
      "text": "Pressure counters divergence.\nWe approximate it by iteratively averaging\nthe divergence of the cell and the pressures\nof the neighbor cells.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pressure counters divergence.\nWe approximate it by iteratively averaging\nthe divergence of the cell and the pressures\nof the neighbor cells.",
      "autoResize": true,
      "lineHeight": 1.25
    },
