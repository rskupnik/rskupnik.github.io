    {
      "id": "xF37wxUIuGvfh4EhimnlF",
      "type": "text",
      "x": 1078.408332824707,
      "y": 122,
      "width": 299.7166748046875,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#228be6",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
