      "version": 439,
      "versionNonce": 1783961681,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1778930712196,
      "link": null,
      "locked": false,
      "text": "In our grid it's quite simple.\nWe subtract pressure to the right\nfrom pressure to the left and divide\nby distance between those sample points",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In our grid it's quite simple.\nWe subtract pressure to the right\nfrom pressure to the left and divide\nby distance between those sample points",
      "autoResize": true,
      "lineHeight": 1.25
    },
