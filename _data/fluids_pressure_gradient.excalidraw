    {
      "id": "M09Gid4Pe5xk7LFdsbNLr",
      "type": "text",
      "x": 763.7988988839401,
      "y": 519.9082815535701,
      "width": 511.0666809082031,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9g",
      "roundness": null,
      "seed": 1746817604,
      "version": 666,
      "versionNonce": 747942079,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1778929451881,
      "link": null,
      "locked": false,
      "text": "Assume divergence is 1.0 at the center cell.\nValues in cells below represent pressure.\nWe only calculate middle cell here but each iteration changes each cell\n(I assume random changes for those)\nDivergence value 1.0 remains static, it serves as an anchor",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Assume divergence is 1.0 at the center cell.\nValues in cells below represent pressure.\nWe only calculate middle cell here but each iteration changes each cell\n(I assume random changes for those)\nDivergence value 1.0 remains static, it serves as an anchor",
      "autoResize": true,
      "lineHeight": 1.25
