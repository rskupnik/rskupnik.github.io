      "type": "text",
      "x": 646.1909970960102,
      "y": 1021.6387508634987,
      "width": 674.9833374023438,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#228be6",
